# Copy to scripts/.distribute.env (gitignored) and replace every <PLACEHOLDER>.
# Sourced by scripts/distribute_android_dev.sh and scripts/distribute_ios_dev.sh.
# Values here override variables exported in the shell.
# Values are quoted so the file stays valid shell.

# --- Android -> Firebase App Distribution ------------------------------------
FIREBASE_APP_ID="<FIREBASE_APP_ID>"
FIREBASE_SERVICE_ACCOUNT_PATH="<FIREBASE_SERVICE_ACCOUNT_PATH>"
TESTER_GROUPS="<TESTER_GROUP_ALIASES>"

# --- iOS -> TestFlight -------------------------------------------------------
BUNDLE_ID="<IOS_DEV_BUNDLE_ID>"
ASC_KEY_ID="<ASC_KEY_ID>"
ASC_ISSUER_ID="<ASC_ISSUER_ID>"
ASC_P8_PATH="<ASC_P8_PATH>"

# Optional (uncomment to use)
# BETA_GROUP="<BETA_GROUP>"
# CERT_KEY_PATH="<CERT_KEY_PATH>"
